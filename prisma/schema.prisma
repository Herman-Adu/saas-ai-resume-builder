// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model Resume {
  id     String @id @default(cuid())
  userId String

  title       String?
  description String?

  photoUrl    String?
  colorHex    String  @default("#000000")
  borderStyle String  @default("squircle")
  // Checked against src/lib/templates.ts, not a database enum, so adding a
  // template never needs a migration.
  template    String  @default("classic")
  summary     String?
  firstName   String?
  lastName    String?
  jobTitle    String?
  city        String?
  country     String?
  phone       String?
  email       String?

  // At most one master per user: enforced by a partial unique index in the
  // content_model migration, which Prisma cannot express in the schema.
  isMaster Boolean @default(false)

  // A copy made by Tailor. Counted separately from base resumes for plan limits.
  isTailored     Boolean  @default(false)
  // Whole sections left out of the preview and PDF (see src/lib/tailoring.ts).
  hiddenSections String[] @default([])

  // The job post this copy was tailored to, if any. Deleting the job keeps the copy.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  workExperiences WorkExperience[]
  educations      Education[]
  links           ResumeLink[]
  certifications  Certification[]
  languages       Language[]
  projects        Project[]
  skills          String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resumes")
}

model WorkExperience {
  id String @id @default(cuid())

  position    String?
  company     String?
  startDate   DateTime?
  endDate     DateTime?
  // Deprecated: replaced by bullets. Kept so the change stays additive.
  description String?
  bullets     Json      @default("[]")
  hidden      Boolean   @default(false)
  sortOrder   Int       @default(0)

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("work_experiences")
}

model Education {
  id String @id @default(cuid())

  degree    String?
  school    String?
  startDate DateTime?
  endDate   DateTime?
  hidden    Boolean   @default(false)
  sortOrder Int       @default(0)

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("educations")
}

model ResumeLink {
  id String @id @default(cuid())

  label     String?
  url       String?
  hidden    Boolean @default(false)
  sortOrder Int     @default(0)

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
  @@map("resume_links")
}

model Certification {
  id String @id @default(cuid())

  name       String?
  issuer     String?
  issuedDate DateTime?
  url        String?
  hidden     Boolean   @default(false)
  sortOrder  Int       @default(0)

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
  @@map("certifications")
}

model Language {
  id String @id @default(cuid())

  name      String?
  level     String?
  hidden    Boolean @default(false)
  sortOrder Int     @default(0)

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
  @@map("languages")
}

model Project {
  id String @id @default(cuid())

  name      String?
  url       String?
  startDate DateTime?
  endDate   DateTime?
  bullets   Json      @default("[]")
  hidden    Boolean   @default(false)
  sortOrder Int       @default(0)

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
  @@map("projects")
}

// Counts CV imports for the daily limit. Holds no CV content on purpose.
model CvImport {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("cv_imports")
}

// A job post the user tailored a resume to. Saved only when they accept changes.
model Job {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  company   String?
  postText  String
  createdAt DateTime @default(now())

  resumes Resume[]

  @@index([userId, createdAt])
  @@map("jobs")
}

// One row per "tailor to a job" AI run, for the daily limit. Holds no CV or job text.
model TailorRun {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("tailor_runs")
}

model UserSubscription {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  stripeCustomerId        String   @unique
  stripeSubscriptionId    String   @unique
  stripePriceId           String
  stripeCurrentPeriodEnd  DateTime
  stripeCancelAtPeriodEnd Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_subscriptions")
}

// Better Auth core tables.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
